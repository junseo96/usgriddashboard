{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "us-grid-atlas",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "us-grid-atlas", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "SCHEDULE_ENABLED": "false", "SCHEDULE_CADENCE": "weekly" }
}
